# ─── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AGENT_MAX_TURNS_PER_LEAD=12          # hard cap on AI replies per lead
AGENT_DAILY_TOKEN_BUDGET=300000      # per-tenant ceiling; over budget = owner handoff

# ─── Twilio ─────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                   # also used to validate inbound webhook signatures
TWILIO_VOICE_NUMBER=                 # local 541 number customers call
TWILIO_SMS_NUMBER=                   # verified toll-free number used for outbound SMS
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_MISSED_CALL_RING_SECONDS=20

# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server-only. never import into a client component.

# ─── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Google ─────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_REVIEW_URL=                   # direct "write a review" link for the GBP listing

# ─── Email ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Tenant ─────────────────────────────────────────────────────────────────
TENANT_SLUG=south-valley-electric    # selects src/config/tenants/<slug>.ts
OWNER_PHONE_NUMBER=
OWNER_EMAIL=
BUSINESS_NAME="South Valley Electric LLC"
BUSINESS_CCB_NUMBER=                 # REQUIRED for production deploy — build fails if unset
BUSINESS_SERVICE_AREA="Cottage Grove, Creswell, Eugene, Springfield, Drain, Yoncalla"

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
CRON_SECRET=                         # bearer token required by every /api/cron/* route
SENTRY_DSN=
