{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "south-valley-electric",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],

  // Static export output. Adding a "main" worker entry here later turns this
  // same project into a server app without changing the deployed URL.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
